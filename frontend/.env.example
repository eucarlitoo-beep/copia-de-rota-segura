# Use the computer's LAN IP address when testing on a phone, not localhost.
EXPO_PUBLIC_BACKEND_URL=http://192.168.0.10:8001

# Optional until push notifications are configured through EAS.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Public OAuth client IDs (never put client secrets in this file).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
