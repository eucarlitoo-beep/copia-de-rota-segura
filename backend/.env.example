MONGO_URL=mongodb://localhost:27017
DB_NAME=rota_segura
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
PUBLIC_BASE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Optional integrations. Keep unset until configured with real credentials.
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=ROTA SEGURA
EMAIL_REPLY_TO=
PUBLIC_APP_URL=rotasegura://reset-password
# Comma-separated OAuth client IDs accepted by the backend token verifier.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Geocoding provider settings; use a stable application identifier.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=ROTA-SEGURA/1.0
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_FOOT_BASE_URL=https://routing.openstreetmap.de/routed-foot
